{
	"luci-mod-system-config": {
		"description": "Grant access to system configuration",
		"read": {
			"cgi-io": [ "read" ],
			"file": {
				"/opt/etc/passwd": [ "read" ]
			},
			"ubus": {
				"luci": [ "getLEDs", "getTimezones", "getUSBDevices", "getUnixtime" ],
				"rc": [ "list" ]
			},
			"uci": [ "luci", "system", "rpcd" ]
		},
		"write": {
			"file": {
				"/opt/sbin/uhttpd -m *": [ "exec" ]
			},
			"ubus": {
				"luci": [ "setLocaltime", "setPassword" ],
				"rc": [ "init" ]
			},
			"uci": [ "luci", "system" ]
		}
	},

	"luci-mod-system-ssh": {
		"description": "Grant access to SSH configuration",
		"read": {
			"file": {
				"/opt/etc/dropbear/authorized_keys": [ "read" ]
			},
			"ubus": {
				"file": [ "read" ]
			},
			"uci": [ "dropbear" ]
		},
		"write": {
			"file": {
				"/opt/etc/dropbear/authorized_keys": [ "write" ]
			},
			"ubus": {
				"file": [ "write" ],
				"luci": [ "setLocaltime" ]
			},
			"uci": [ "dropbear" ]
		}
	},

	"luci-mod-system-repokeys": {
		"description": "Grant access to Software Repository Public Key management",
		"read": {
			"file": {
				"/opt/etc/opkg/keys/*": [ "read" ],
				"/opt/etc/apk/keys/*": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/opt/etc/opkg/keys/*": [ "write" ],
				"/opt/etc/apk/keys/*": [ "write" ]
			}
		}
	},

	"luci-mod-system-plugins": {
		"description": "Grant access to Plugin management",
		"read": {
			"file": {
				"/opt/share/ucode/luci/*": [ "read" ],
				"/opt/www/luci-static/resources/view/plugins": [ "list" ],
				"/opt/www/luci-static/resources/view/plugins/*": [ "read" ]
			},
			"uci": [ "luci_plugins" ]
		},
		"write": {
			"uci": [ "luci_plugins" ]
		}
	},

	"luci-mod-system-uhttpd": {
		"description": "Grant access to uHTTPd configuration",
		"read": {
			"uci": [ "uhttpd" ]
		},
		"write": {
			"uci": [ "uhttpd" ]
		}
	},


	"luci-mod-system-init": {
		"description": "Grant access to startup configuration",
		"read": {
			"file": {
				"/opt/etc/init.d": [ "list" ]
			},
			"ubus": {
				"file": [ "list" ]
			}
		},
		"write": {
			"file": {
				"/opt/etc/init.d/*": [ "exec" ],
				"/opt/bin/chmod": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		}
	},

	"luci-mod-system-cron": {
		"description": "Grant access to crontab configuration",
		"read": {
			"file": {
				"/opt/etc/cron.d/root": [ "read" ]
			},
			"ubus": {
				"file": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/opt/etc/cron.d/root": [ "write" ],
				"/opt/etc/init.d/S10cron": [ "exec" ]
			},
			"ubus": {
				"file": [ "write", "exec" ]
			}
		}
	},

	"luci-mod-system-mounts": {
		"description": "Grant access to mount configuration",
		"read": {
			"file": {
				"/opt/etc/filesystems": [ "read" ],
				"/proc/filesystems": [ "read" ],
				"/opt/bin/btrfsck": [ "list" ],
				"/opt/bin/ntfsfix": [ "list" ],
				"/opt/sbin/e2fsck": [ "list" ],
				"/opt/sbin/fsck.f2fs": [ "list" ],
				"/opt/sbin/fsck.fat": [ "list" ]
			},
			"ubus": {
				"file": [ "read", "stat" ],
				"luci": [ "getBlockDevices", "getMountPoints" ]
			},
			"uci": [ "fstab" ]
		},
		"write": {
			"file": {
				"/opt/bin/umount": [ "exec" ],
				"/opt/sbin/block": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "write" ],
				"luci": [ "setBlockDetect" ]
			},
			"uci": [ "fstab" ]
		}
	},

	"luci-mod-system-flash": {
		"description": "Grant access to flash operations",
		"read": {
			"cgi-io": [ "backup", "download" ],
			"file": {
				"/dev/mtdblock[0-9]*": [ "read" ],
				"/opt/etc/sysupgrade.conf": [ "read" ],
				"/opt/lib/upgrade/platform.sh": [ "list" ],
				"/proc/mounts": [ "read" ],
				"/proc/*/mounts": [ "read" ],
				"/proc/mtd": [ "read" ],
				"/proc/partitions": [ "read" ],
				"/proc/sys/kernel/hostname": [ "read" ],
				"/opt/sbin/sysupgrade --list-backup": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read", "stat" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/opt/bin/tar -tzf /tmp/backup.tar.gz": [ "exec" ],
				"/opt/etc/sysupgrade.conf": [ "write" ],
				"/opt/sbin/firstboot -r -y": [ "exec" ],
				"/opt/sbin/reboot": [ "exec" ],
				"/opt/sbin/sysupgrade --force /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade -n --force /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade --force -k /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade --force -u /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade --force -u -k /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade -n /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade -k /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade -u /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade -u -k /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade --restore-backup /tmp/backup.tar.gz": [ "exec" ],
				"/opt/sbin/sysupgrade --test /tmp/firmware.bin": [ "exec" ],
				"/opt/sbin/sysupgrade /tmp/firmware.bin": [ "exec" ],
				"/tmp/backup.tar.gz": [ "write" ],
				"/tmp/firmware.bin": [ "write" ]
			},
			"ubus": {
				"file": [ "exec", "remove", "write" ],
				"system": [ "validate_firmware_image" ]
			}
		}
	},

	"luci-mod-system-reboot": {
		"description": "Allow rebooting the device",
		"write": {
			"file": {
				"/opt/sbin/reboot": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"system": [ "reboot" ]
			}
		}
	},

	"luci-mod-system-pwpolicy": {
		"description": "Grant access to password policy configuration",
		"read": {
			"uci": [ "rpcd" ]
		},
		"write": {
			"uci": [ "rpcd" ]
		}
	}

}
