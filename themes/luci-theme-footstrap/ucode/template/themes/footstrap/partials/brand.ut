{#
 Shared brand block (logo + hostname wordmark). Included as
 include('themes/footstrap/partials/brand', { boardinfo }); the look lives in
 styles/theme/10-chrome.css.
 Licensed to the public under the Apache License 2.0.
-#}
<a class="fs-brand" href="{{ dispatcher.build_url() }}">
	<span class="fs-logo">
		<svg aria-hidden="true" viewBox="0 0 256 256"><path fill="#036" d="m181 139 51 27-104 56V55l104 56z"/><path fill="#ccc" d="M128 55v167L24 166l51-27-51-28z"/><path fill="#036" d="m88 115 104-56V35l-40 2V13L48 69v24z"/><path fill="#ccc" d="m128 112 104-56v34l-76 40v22l76-41v34l-76 41v21l76-41v34l-104 56z"/><path fill="#036" d="M128 112 24 56v34l76 40v22l-76-41v34l76 41v21l-76-41v34l104 56z"/><path fill="#fff" d="M24 56 128 0l24 13-75 41 15 8 76-41 24 14-75 40 15 9 76-41 24 13-104 56z"/></svg>
	</span>
	<span class="fs-wordmark">{{ entityencode(striptags(boardinfo.hostname ?? 'Entware'), true) }}</span>
</a>
